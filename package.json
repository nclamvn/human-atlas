{
  "name": "human-atlas-vietnamese",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3016",
    "content:accept": "node scripts/content/compile-content.mjs --accept",
    "content:build": "node scripts/content/compile-content.mjs",
    "content:check": "node scripts/content/validate-content.mjs",
    "content:bites": "node scripts/content/content-bites.mjs",
    "narration:generate": "node scripts/generate-narration.mjs blood-journey",
    "voice:generate": "node scripts/generate-product-voice.mjs",
    "budget": "node scripts/validate-bundle.mjs",
    "build": "npm run content:build && vite build && npm run budget",
    "build:vercel": "vite build",
    "check": "tsc --noEmit",
    "test": "npm run content:check && npm run content:bites && node scripts/validate-atlas.mjs && node scripts/validate-atlas.mjs atlas-female.json && node scripts/validate-interactions.mjs && node scripts/validate-female-abdomen.mjs && node scripts/validate-female-presentation.mjs && node scripts/validate-tour-engine.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "^1.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
